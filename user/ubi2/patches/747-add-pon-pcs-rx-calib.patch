--- /dev/null
+++ target/linux/airoha/patches-6.18/747-net-pcs-airoha-apply-manual-rx-calib-to-pon-pcs.patch
@@ -0,0 +1,37 @@
+From: W1700K2 user
+Subject: [PATCH] net: pcs: airoha: apply manual RX calibration to PON PCS
+
+On AN7581 boards that use the PON SerDes as a 10G Ethernet port, such
+as the WAN port of the Gemtek W1700K2 (HW 2.1, RTL8261CE PHYs, E2
+silicon), the port reports no carrier and never receives frames. The
+LAN2 port on the Ethernet PCS works because it gets manual RX
+calibration; the PON PCS was excluded from that check.
+
+Apply the same manual RX calibration to the PON PCS. Based on the
+change reported working on HW 2.1 in the OpenWrt forum thread
+"Quantum Fiber W1700k support" (post #3701).
+
+Applies on top of 745-net-pcs-airoha-extend-manual-rx-calib-to-E2-silicon.patch.
+---
+--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
++++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
+@@ -1316,11 +1316,16 @@
+ 	if (IS_ERR(priv->xfi_rst))
+ 		return dev_err_probe(dev, PTR_ERR(priv->xfi_rst), "failed to get xfi reset lines\n");
+ 
+-	/* For Ethernet PCS, read the AN7581 SoC revision to check if
+-	 * manual rx calibration is needed. Extend the manual-calibration
++	/* For Ethernet and PON PCS, read the AN7581 SoC revision to check
++	 * if manual rx calibration is needed. Extend the manual-calibration
+ 	 * threshold to include E2 silicon.
++	 *
++	 * The PON PCS is used as a second 10G Ethernet port on some boards
++	 * (e.g. the WAN port of the Gemtek W1700K2 with an RTL8261CE PHY)
++	 * and needs the same manual calibration, otherwise RX never locks.
+ 	 */
+-	if (device_is_compatible(dev, "airoha,an7581-pcs-eth")) {
++	if (device_is_compatible(dev, "airoha,an7581-pcs-eth") ||
++	    device_is_compatible(dev, "airoha,an7581-pcs-pon")) {
+ 		u32 val;
+ 
+ 		ret = regmap_read(priv->scu, AIROHA_SCU_PDIDR, &val);
